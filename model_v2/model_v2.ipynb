    "    if len(x) < 2 or np.sum(w) == 0:\n",
    "        continue\n",
    "        \n",
    "    # Pre-calculate the WOLS Denominator\n",
    "    x_wmean = np.average(x, weights=w)\n",
    "    x_dev = x - x_wmean\n",
    "    SS_x_w = np.sum(w * (x_dev**2))\n",
    "    \n",
