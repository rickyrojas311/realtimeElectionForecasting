    "plt.ylabel(\"Proportion of Total Votes Returned\", fontsize=12)\n",
    "\n",
    "# Set Y-axis strictly from 0 to 1\n",
    "plt.ylim(0, 1)\n",
    "\n",
    "# Add gridlines and legend\n",
    "plt.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "plt.legend(bbox_to_anchor=(1.05, 1), loc=\"upper left\", title=\"Races\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
